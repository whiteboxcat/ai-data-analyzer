# Copy to .env and fill in at least one key. Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: override the default models
# OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_MODEL=claude-sonnet-5-5
# GEMINI_MODEL=gemini-3.8-flash

FLASK_SECRET_KEY=change-me
# Login password. Optional locally; REQUIRED online (the app refuses to start without it).
APP_PASSWORD=
MAX_UPLOAD_MB=50

# --- Google Sheets / Drive links -------------------------------------------
# Private access: paste the WHOLE service-account key JSON on one line,
# or point GOOGLE_APPLICATION_CREDENTIALS at the key file.
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
# Max size of a linked file (MB)
MAX_LINK_MB=200
# Max loaded data size (MB). Default: unlimited locally, 120 on Render free.
# MAX_DATA_MB=120
